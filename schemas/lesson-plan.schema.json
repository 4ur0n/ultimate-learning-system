{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4ur0n/ultimate-learning-system/schemas/lesson-plan.schema.json",
  "title": "ULS Lesson Plan",
  "description": "Schema for evidence-aware lesson plans generated by the ULS Lesson Planner Runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "learning_contract",
    "path",
    "completion_policy",
    "replanning_triggers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_version": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "learning_contract": {
      "$ref": "#/$defs/learningContract"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "prerequisite_closure": {
      "$ref": "#/$defs/prerequisiteClosure"
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pathNode"
      }
    },
    "alternative_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alternativePath"
      }
    },
    "diagnostic_checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "review_checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewCheckpoint"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferredItem"
      }
    },
    "estimated_time": {
      "$ref": "#/$defs/timeEstimate"
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "completion_policy": {
      "$ref": "#/$defs/completionPolicy"
    },
    "replanning_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "failed-prerequisite-check",
          "learner-exceeds-assumptions",
          "misconception-discovered",
          "persistent-cognitive-overload",
          "repeated-strategy-failure",
          "goal-changed",
          "deadline-changed",
          "source-updated",
          "review-fragility-detected",
          "safety-issue",
          "source-conflict",
          "tool-unavailable"
        ]
      }
    },
    "change_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeRecord"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "PAUSED",
        "GOAL_MET",
        "GOAL_PARTIALLY_MET",
        "COMPRESSED_PATH_COMPLETE",
        "REVIEW_PENDING",
        "BLOCKED",
        "ABANDONED_BY_LEARNER",
        "SUPERSEDED"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "capability": {
      "type": "string",
      "enum": [
        "recall",
        "explain",
        "recognize_relationships",
        "predict",
        "compare",
        "classify",
        "trace",
        "calculate",
        "apply",
        "implement",
        "debug",
        "analyze",
        "transfer",
        "teach_back",
        "retain"
      ]
    },
    "learningContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "target_concepts",
        "required_capabilities",
        "target_depth",
        "completion_condition"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "target_concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "target_depth": {
          "type": "string",
          "enum": ["overview", "conceptual", "practical", "advanced"]
        },
        "mode": {
          "type": "string",
          "enum": ["durable-learning", "exam-readiness", "immediate-task"]
        },
        "time_budget_minutes": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "deadline": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "language": {
          "type": "string",
          "maxLength": 80
        },
        "source_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "completion_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "confidence", "status"],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string",
          "enum": ["untested", "supported", "weakened", "rejected"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "prerequisiteClosure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "soft": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "diagnostic": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "vocabulary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "pathNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "concepts",
        "target_capabilities",
        "role",
        "disposition",
        "progression_rule"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "target_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "role": {
          "type": "string",
          "enum": [
            "orientation",
            "diagnostic",
            "prerequisite",
            "core",
            "safety-critical",
            "practice",
            "assessment",
            "transfer",
            "consolidation",
            "review"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "skip-satisfied",
            "diagnostic-check",
            "short-repair",
            "full-instruction",
            "guided-practice",
            "independent-practice",
            "near-transfer",
            "far-transfer",
            "review",
            "deferred"
          ]
        },
        "hard_prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "soft_prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "strategy_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedEvidence"
          }
        },
        "progression_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "fallback_route": {
          "$ref": "#/$defs/identifier"
        },
        "estimated_minutes": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "active",
            "completed",
            "skipped",
            "blocked",
            "deferred"
          ]
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "expectedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "independence"],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "independence": {
          "type": "string",
          "enum": [
            "fully-guided",
            "partially-guided",
            "prompted",
            "independent",
            "self-corrected-independent"
          ]
        },
        "transfer_distance": {
          "type": "string",
          "enum": [
            "same-item",
            "same-structure",
            "near-transfer",
            "far-transfer",
            "novel-domain"
          ]
        },
        "retention_interval_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "alternativePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "node_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "activation_trigger": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_claim", "task_type", "route_if_pass", "route_if_fail"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "target_claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "task_type": {
          "type": "string",
          "enum": [
            "free-retrieval",
            "short-answer",
            "explanation",
            "prediction",
            "comparison",
            "application",
            "debugging",
            "diagram-interpretation",
            "teach-back"
          ]
        },
        "route_if_pass": {
          "$ref": "#/$defs/identifier"
        },
        "route_if_fail": {
          "$ref": "#/$defs/identifier"
        },
        "route_if_ambiguous": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "reviewCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "capability", "reason"],
      "properties": {
        "concept": {
          "$ref": "#/$defs/identifier"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "earliest_after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "latest_after_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deferredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "consequence": {
          "type": "string",
          "maxLength": 1500
        }
      }
    },
    "timeEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_minutes", "upper_minutes", "uncertainty"],
      "properties": {
        "lower_minutes": {
          "type": "number",
          "minimum": 0
        },
        "upper_minutes": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "severity", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "prerequisite",
            "misconception",
            "cognitive-load",
            "time",
            "source-integrity",
            "safety",
            "accessibility",
            "tooling"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "blocking"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "mitigation": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_claims", "allowed_results"],
      "properties": {
        "required_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "GOAL_MET",
              "GOAL_PARTIALLY_MET",
              "COMPRESSED_PATH_COMPLETE",
              "REVIEW_PENDING",
              "BLOCKED",
              "ABANDONED_BY_LEARNER"
            ]
          }
        },
        "requires_delayed_retention": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "changeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "timestamp", "reason", "changes"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
