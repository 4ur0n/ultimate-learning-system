{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4ur0n/ultimate-learning-system/schemas/lesson-package.schema.json",
  "title": "ULS Lesson Package",
  "description": "Portable manifest for bundling ULS lesson content, visuals, assessments, rubrics, provenance, and accessibility assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "version",
    "title",
    "audience",
    "learning_contract_ref",
    "lesson_plan_ref",
    "entrypoint",
    "resources",
    "provenance",
    "accessibility",
    "privacy",
    "validation"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "package_id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1},
    "previous_version": {"type": ["integer", "null"], "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "description": {"type": "string", "maxLength": 3000},
    "language": {"type": "string", "minLength": 2, "maxLength": 80},
    "audience": {
      "type": "string",
      "enum": ["learner", "instructor", "public", "system"]
    },
    "delivery_mode": {
      "type": "string",
      "enum": ["interactive", "self-study", "instructor-led", "print", "hybrid"]
    },
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "learning_contract_ref": {"$ref": "#/$defs/identifier"},
    "lesson_plan_ref": {"$ref": "#/$defs/identifier"},
    "knowledge_model_version": {"type": "string", "minLength": 1},
    "entrypoint": {"$ref": "#/$defs/path"},
    "sequence": {
      "type": "array",
      "items": {"$ref": "#/$defs/sequenceEntry"}
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resource"}
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "provenance": {"$ref": "#/$defs/provenanceManifest"},
    "accessibility": {"$ref": "#/$defs/accessibilityManifest"},
    "privacy": {"$ref": "#/$defs/privacyManifest"},
    "validation": {"$ref": "#/$defs/validationManifest"},
    "change_log": {
      "type": "array",
      "items": {"$ref": "#/$defs/changeRecord"}
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "SUPERSEDED", "RETRACTED", "BLOCKED"]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "recall", "explain", "recognize_relationships", "predict", "compare",
        "classify", "trace", "calculate", "apply", "implement", "debug",
        "analyze", "transfer", "teach_back", "retain"
      ]
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "content-block", "lesson-markdown", "html", "stylesheet", "script",
        "svg", "image", "audio", "video", "transcript", "assessment",
        "rubric", "answer-key", "provenance", "accessibility", "data", "other"
      ]
    },
    "sequenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_ref", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "resource_ref": {"$ref": "#/$defs/identifier"},
        "role": {
          "type": "string",
          "enum": [
            "orientation", "diagnostic", "prerequisite", "explanation", "example",
            "visual", "guided-practice", "independent-practice", "assessment",
            "transfer", "summary", "review", "answer-key", "instructor-note"
          ]
        },
        "required": {"type": "boolean", "default": true},
        "prerequisite_entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "completion_rule": {"type": "string", "maxLength": 2000}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "media_type", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"$ref": "#/$defs/resourceType"},
        "path": {"$ref": "#/$defs/path"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 200},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "maxLength": 300},
        "concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        },
        "visibility": {
          "type": "string",
          "enum": ["learner", "instructor", "system", "public"]
        },
        "generated": {"type": "boolean"},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "accessibility_ref": {"$ref": "#/$defs/identifier"},
        "assessment_ref": {"$ref": "#/$defs/identifier"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "type": {
          "type": "string",
          "enum": ["schema", "runtime", "renderer", "library", "font", "external-service"]
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "required": {"type": "boolean", "default": true},
        "license": {"type": "string", "maxLength": 200}
      }
    },
    "provenanceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenanceEntry"}
        },
        "unresolved_conflicts": {
          "type": "array",
          "items": {"type": "string", "maxLength": 3000}
        }
      }
    },
    "provenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_class", "resource_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "content_class": {
          "type": "string",
          "enum": ["SOURCE", "VERIFIED_ENRICHMENT", "TEACHING_ANALOGY", "INFERENCE", "UNCERTAIN"]
        },
        "source_uri": {"type": "string", "maxLength": 2000},
        "locator": {"type": "string", "maxLength": 500},
        "resource_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "verification_status": {
          "type": "string",
          "enum": ["unverified", "verified", "conflicted", "not-required"]
        },
        "license": {"type": "string", "maxLength": 300}
      }
    },
    "accessibilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "entries", "checks"],
      "properties": {
        "language": {"type": "string", "minLength": 2, "maxLength": 80},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/accessibilityEntry"}
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading_order", "alt_text", "non_color_encoding", "reading_order"],
          "properties": {
            "heading_order": {"type": "boolean"},
            "alt_text": {"type": "boolean"},
            "non_color_encoding": {"type": "boolean"},
            "reading_order": {"type": "boolean"},
            "contrast": {"type": "boolean"},
            "captions_or_transcripts": {"type": "boolean"},
            "keyboard_navigation": {"type": "boolean"}
          }
        }
      }
    },
    "accessibilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "resource_ref": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "maxLength": 500},
        "description": {"type": "string", "maxLength": 4000},
        "transcript_ref": {"$ref": "#/$defs/identifier"},
        "reading_order": {
          "type": "array",
          "items": {"type": "string", "maxLength": 200}
        }
      }
    },
    "privacyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contains_personal_data", "contains_raw_learner_responses"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["learner-safe", "instructor-authorized", "public-anonymized", "system-private"]
        },
        "contains_personal_data": {"type": "boolean"},
        "contains_raw_learner_responses": {"type": "boolean"},
        "student_model_fields_included": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 300}
        },
        "authorization_ref": {"type": "string", "maxLength": 500},
        "anonymization_applied": {"type": "boolean"}
      }
    },
    "validationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "content", "privacy", "accessibility", "integrity"],
      "properties": {
        "schema": {"$ref": "#/$defs/validationResult"},
        "content": {"$ref": "#/$defs/validationResult"},
        "privacy": {"$ref": "#/$defs/validationResult"},
        "accessibility": {"$ref": "#/$defs/validationResult"},
        "integrity": {"$ref": "#/$defs/validationResult"},
        "render": {"$ref": "#/$defs/validationResult"}
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["not-run", "passed", "failed", "blocked"]},
        "checked_at": {"$ref": "#/$defs/timestamp"},
        "validator": {"type": "string", "maxLength": 300},
        "issues": {
          "type": "array",
          "items": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "changeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "timestamp", "reason", "changes"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "maxLength": 1000}
        },
        "affected_resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
